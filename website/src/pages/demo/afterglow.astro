---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HourVideo from '../../components/HourVideo.astro';
import golden from '../../../../examples/rice/afterglow/hour-golden-hour.jpg';
import afterglow from '../../../../examples/rice/afterglow/hour-afterglow.jpg';
import blue from '../../../../examples/rice/afterglow/hour-blue-hour.jpg';
import night from '../../../../examples/rice/afterglow/hour-night.jpg';

const hours = [
  { image: golden, name: 'Golden hour', note: 'gold rim', color: '#ffcf8a' },
  { image: afterglow, name: 'Afterglow', note: 'amber rim', color: '#ffb070' },
  { image: blue, name: 'Blue hour', note: 'rose rim', color: '#ff9ec0' },
  { image: night, name: 'Night', note: 'silver rim', color: '#a9c1ff' }
];

const shortcuts: Array<[string[], string]> = [
  [['Super', 'T'], 'Drift to the next hour of light'],
  [['Super', 'Shift', 'T'], 'Drift back to the previous hour'],
  [['Super', 'O'], 'Native 3D overview of every window'],
  [['Super', 'Tab'], 'Focus the next window'],
  [['Super', 'Q'], 'Close — the window sinks into the sea'],
  [['Super', '1–3'], 'Workspaces shore, studio and harbor'],
  [['Super', 'F'], 'First-person mode above the water'],
  [['Super', 'D'], 'Launcher']
];
---
<BaseLayout
  title="Afterglow · Shady"
  description="Afterglow is a Shady rice: live Wayland windows floating above a procedural sunset sea that moves through four hours of light."
  path="/demo/afterglow/"
>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Featured rice</p>
      <h1><span class="gradient-text">Afterglow</span></h1>
      <p class="lede">
        A low sun over a mirror-still sea. Live Wayland windows float like warm
        glass panes above the water, and the sky, the sea, the window accents and
        the shell drift together through four hours of light. The whole scene
        comes from one external C plugin; none of it lives in the compositor core.
      </p>
    </div>
  </header>

  <div class="page-content">
    <div class="shell">
      <HourVideo controls tag="Recorded headless at 1080p · 17 s loop" />

      <section class="section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Four hours</p>
            <h2>One light, everywhere.</h2>
          </div>
          <p>
            Each hour cross-fades over 2.4 seconds. The plugin also pushes the new
            accent into the compositor, so focus borders, title-bar pips and the
            floor follow the sky they sit under.
          </p>
        </div>
        <div class="phase-grid">
          {hours.map((hour) => (
            <figure class="phase" style={`--c: ${hour.color}`}>
              <img src={hour.image.src} width={hour.image.width} height={hour.image.height} loading="lazy" alt={`Afterglow at ${hour.name.toLowerCase()}`} />
              <figcaption><span class="dot"></span>{hour.name}<span>· {hour.note}</span></figcaption>
            </figure>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="two-col">
          <div>
            <p class="eyebrow">Run it</p>
            <h2>Watch the sun go down.</h2>
            <p class="lede">
              The launcher starts the themed shell and a terminal. Press
              <kbd>Super</kbd> + <kbd>T</kbd> to change the hour.
            </p>
          </div>
          <div class="code-window">
            <div class="code-title">terminal</div>
            <pre><code>nix develop
./build.sh
./examples/rice/afterglow/run.sh

# On a real Linux VT
./examples/rice/afterglow/run-native.sh

# Start at another hour
SHADY_AFTERGLOW_PHASE="blue hour" ./examples/rice/afterglow/run.sh</code></pre>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <div>
            <p class="eyebrow">Controls</p>
            <h2>Under your fingers.</h2>
          </div>
          <p>Every binding lives in the rice's Lua runtime layer or its plugin, so you can rebind any of them.</p>
        </div>
        <table class="shortcuts">
          <thead><tr><th>Shortcut</th><th>Action</th></tr></thead>
          <tbody>
            {shortcuts.map(([keys, action]) => (
              <tr>
                <td>{keys.map((key, i) => <>{i > 0 && ' + '}<kbd>{key}</kbd></>)}</td>
                <td>{action}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section class="section">
        <div class="card-grid">
          <article class="card">
            <span class="kicker">Render</span>
            <h3>A sky with real depth</h3>
            <p>Each pixel traces a world-space ray from the camera the host gives render hooks. The horizon, sun and moon stay fixed while you orbit, and the sea mirrors them through rippled, Fresnel-weighted water.</p>
          </article>
          <article class="card">
            <span class="kicker">Cohesion</span>
            <h3>Shared palette</h3>
            <p>Hour changes update the compositor's accent config, and the shell reads the same palette from <code>theme.sh</code>, so frames, pips and panels all match the sky.</p>
          </article>
          <article class="card">
            <span class="kicker">Restraint</span>
            <h3>Idle stays idle</h3>
            <p>The sky only advances while frames are already being drawn, so a still desktop renders nothing. Every hour change runs in the headless sanitizer suite.</p>
          </article>
        </div>
      </section>

      <div class="cta">
        <div>
          <h2>Build your own evening.</h2>
          <p>Afterglow is about 350 lines of C plus one fragment shader. Start from it, or from the plugin API.</p>
        </div>
        <div class="button-row" style="margin-top: 0">
          <a class="button primary" href="/docs/c-plugin-api/">C plugin API</a>
          <a class="button" href="https://github.com/jihoo12/shady/tree/main/examples/rice/afterglow">Rice source ↗</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
