<?xml version="1.0" encoding="UTF-8"?>
<protocol name="shady_shell_v1">
  <copyright>
    Copyright 2026 Shady contributors
    SPDX-License-Identifier: MIT
  </copyright>

  <interface name="shady_shell_v1" version="4">
    <description summary="Shady desktop shell control protocol">
      Exposes desktop state to trusted shell clients and provides shell actions
      for workspaces and mapped application windows.
    </description>

    <request name="activate_workspace">
      <arg name="name" type="string" summary="workspace name"/>
    </request>

    <event name="workspace">
      <arg name="name" type="string" summary="known workspace name"/>
    </event>

    <event name="active_workspace">
      <arg name="name" type="string" summary="currently active workspace"/>
    </event>

    <event name="focused_window">
      <arg name="app_id" type="string" summary="focused app id, empty if none"/>
      <arg name="title" type="string" summary="focused title, empty if none"/>
    </event>

    <event name="toggle_launcher">
      <description summary="toggle the shell application launcher"/>
    </event>

    <event name="done">
      <description summary="initial snapshot complete"/>
    </event>

    <request name="activate_window" since="2">
      <arg name="id" type="uint" summary="stable shell window id"/>
    </request>

    <request name="close_window" since="2">
      <arg name="id" type="uint" summary="stable shell window id"/>
    </request>

    <event name="window" since="2">
      <description summary="mapped window snapshot or update"/>
      <arg name="id" type="uint" summary="stable shell window id"/>
      <arg name="app_id" type="string" summary="application id"/>
      <arg name="title" type="string" summary="window title"/>
      <arg name="workspace" type="string" summary="workspace name"/>
      <arg name="focused" type="uint" summary="1 when focused"/>
    </event>

    <event name="window_removed" since="2">
      <arg name="id" type="uint" summary="removed shell window id"/>
    </event>

    <request name="toggle_maximize" since="3">
      <arg name="id" type="uint" summary="stable shell window id"/>
    </request>

    <request name="toggle_fullscreen" since="3">
      <arg name="id" type="uint" summary="stable shell window id"/>
    </request>

    <request name="move_window_to_workspace" since="3">
      <arg name="id" type="uint" summary="stable shell window id"/>
      <arg name="workspace" type="string" summary="target workspace"/>
    </request>

    <event name="window_state" since="3">
      <arg name="id" type="uint" summary="stable shell window id"/>
      <arg name="maximized" type="uint" summary="1 when maximized"/>
      <arg name="fullscreen" type="uint" summary="1 when fullscreen"/>
    </event>

    <request name="cycle_window" since="4">
      <description summary="focus the next visible window"/>
    </request>

    <request name="terminate" since="4">
      <description summary="terminate the Shady compositor session"/>
    </request>
  </interface>
</protocol>
